#!/usr/bin/env bash
set -euo pipefail

: "${ZANE_REAL_CMAKE:?set ZANE_REAL_CMAKE to the platform CMake executable}"

for argument in "$@"; do
	case "$argument" in
		--build|--install|--version|--help|-E|-P)
			exec "$ZANE_REAL_CMAKE" "$@"
			;;
	esac
done

# LLVM's compiler check treats Nix Clang on Darwin as a libstdc++ build unless
# libc++ is explicitly selected. Darwin's Nix toolchain uses libc++.
exec "$ZANE_REAL_CMAKE" -DLLVM_ENABLE_LIBCXX=ON "$@"
